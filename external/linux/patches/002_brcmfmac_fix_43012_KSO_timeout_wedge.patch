@@ -526,6 +526,7 @@ struct brcmf_sdio {
 	bool txglom;		/* host tx glomming enable flag */
 	u16 head_align;		/* buffer pointer alignment */
 	u16 sgentry_align;	/* scatter-gather buffer alignment */
+	atomic_t kso_err_pending;	/* bus_sleep failure awaits recovery */
 };
 
 /* clkstate */
@@ -983,6 +984,13 @@ brcmf_sdio_bus_sleep(struct brcmf_sdio *bus, bool sleep, bool pendok)
 		if (err) {
 			brcmf_err("error while changing bus sleep state %d\n",
 				  err);
+			/* A timeout here usually means the dongle has wedged
+			 * (no CMD52 response). Record it and let the watchdog
+			 * thread schedule the bus reset outside of any
+			 * sdio host lock so mmc_hw_reset() can proceed.
+			 */
+			if (err == -ETIMEDOUT)
+				atomic_set(&bus->kso_err_pending, 1);
 			goto done;
 		}
 	}
@@ -2712,6 +2720,11 @@ static void brcmf_sdio_dpc(struct brcmf_sdio *bus)
 	if ((bus->sdiodev->state != BRCMF_SDIOD_DATA) || (err != 0)) {
 		brcmf_err("failed backplane access over SDIO, halting operation\n");
 		atomic_set(&bus->intstatus, 0);
+		/* A CMD52/CMD53 timeout means the dongle is unresponsive;
+		 * have the watchdog schedule a bus reset to recover.
+		 */
+		if (err == -ETIMEDOUT)
+			atomic_set(&bus->kso_err_pending, 1);
 		if (bus->ctrl_frame_stat) {
 			sdio_claim_host(bus->sdiodev->func1);
 			if (bus->ctrl_frame_stat) {
@@ -3653,8 +3666,21 @@ void brcmf_sdio_isr(struct brcmf_sdio *bus, bool in_isr)
 
 static void brcmf_sdio_bus_watchdog(struct brcmf_sdio *bus)
 {
+	struct brcmf_pub *drvr = bus->sdiodev->bus_if->drvr;
+
 	brcmf_dbg(TIMER, "Enter\n");
 
+	/* Recover from a dongle that stopped responding on SDIO (CMD52
+	 * timeout in brcmf_sdio_bus_sleep). Schedule the same bus reset
+	 * used for firmware crashes; it runs mmc_hw_reset() and re-probes
+	 * the device. Handled here so no sdio host lock is held.
+	 */
+	if (atomic_xchg(&bus->kso_err_pending, 0) &&
+	    drvr && bus->sdiodev->state == BRCMF_SDIOD_DATA) {
+		brcmf_err("dongle unresponsive, scheduling bus reset\n");
+		schedule_work(&drvr->bus_reset);
+	}
+
 	/* Poll period: check device if appropriate. */
 	if (!bus->sr_enabled &&
 	    bus->poll && (++bus->polltick >= bus->pollrate)) {
@@ -4495,7 +4521,13 @@ struct brcmf_sdio *brcmf_sdio_probe(struct brcmf_sdio_dev *sdiodev)
 
 	/* ...and initialize clock/power states */
 	bus->clkstate = CLK_SDONLY;
-	bus->idletime = BRCMF_IDLE_INTERVAL;
+	/* Keep the dongle awake. The BCM43012 KSO wake handshake is synced
+	 * to the PMU 32 kHz clock (internal RC here, per NVRAM lpo_select=4)
+	 * and intermittently times out (-110) after long soak times, wedging
+	 * the SDIO bus with no recovery. The board is mains-powered, so the
+	 * extra idle current beats an unrecoverable WiFi outage.
+	 */
+	bus->idletime = BRCMF_IDLE_ACTIVE;
 	bus->idleclock = BRCMF_IDLE_ACTIVE;
 
 	/* SR state */
